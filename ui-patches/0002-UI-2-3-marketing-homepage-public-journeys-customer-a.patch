+/* Marketing homepage. Purpose-built for .aaa-home; no legacy .home-page styles. */
+.aaa-home {--home-ink:#071827;--home-blue:#0b88d1;--home-blue-deep:#086ca8;--home-light:#ecf8ff;color:#0c2135;background:#fff;overflow:hidden;}
+.aaa-home__shell{width:min(1280px,calc(100% - 2 * var(--aaa-gutter)));margin-inline:auto;}
+.aaa-home__hero{position:relative;isolation:isolate;background:#081827;color:#fff;overflow:hidden;}
+.aaa-home__hero::before{content:"";position:absolute;inset:0;z-index:-1;background:radial-gradient(ellipse 60% 82% at 86% 10%,rgba(23,167,245,.23),transparent 65%),radial-gradient(ellipse 45% 70% at 6% 100%,rgba(45,155,210,.14),transparent 66%);}
+.aaa-home__hero::after{content:"";position:absolute;width:650px;height:650px;right:-190px;top:-320px;border:1px solid rgba(125,219,255,.13);border-radius:50%;box-shadow:0 0 0 80px rgba(125,219,255,.023),0 0 0 160px rgba(125,219,255,.02);pointer-events:none;}
+.aaa-home__hero-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(320px,.75fr);align-items:center;gap:clamp(44px,7vw,110px);padding-block:clamp(76px,9vw,132px) clamp(76px,9vw,126px);position:relative;z-index:1;}
+.aaa-home__intro{min-width:0;}
+.aaa-home__kicker{display:inline-flex;align-items:center;gap:9px;color:#a9e2ff;border:1px solid rgba(113,201,249,.27);background:rgba(93,195,249,.08);padding:10px 15px;border-radius:999px;font-size:11px;font-weight:850;letter-spacing:.14em;text-transform:uppercase;margin-bottom:30px;}
+.aaa-home__kicker svg{font-size:14px;color:#65c8ff;}
+.aaa-home__intro h1{font-size:clamp(3.25rem,5.9vw,6.65rem);line-height:1.005;font-weight:850;letter-spacing:-.083em;color:#fff!important;margin:0 0 27px;text-wrap:balance;}
+.aaa-home__intro h1 span{color:#79d3ff;}
+.aaa-home__lede{max-width:570px;color:#b8cbd9!important;font-size:clamp(16px,1.4vw,19px);line-height:1.8;margin:0 0 34px;}
+.aaa-home__search{width:min(770px,calc(100% + 95px));display:grid;grid-template-columns:minmax(0,1.18fr) minmax(0,.9fr) auto;align-items:stretch;background:#fff;border:1px solid rgba(255,255,255,.45);border-radius:20px;padding:7px;box-shadow:0 20px 65px rgba(0,10,26,.27);position:relative;z-index:2;}
+.aaa-home__search-field{display:flex;flex-direction:column;gap:4px;justify-content:center;padding:9px 15px;min-width:0;color:#0b192b!important;}
+.aaa-home__search-field+.aaa-home__search-field{border-left:1px solid #e1ebf2;}
+.aaa-home__search-field>span{font-size:10px;font-weight:850;letter-spacing:.12em;text-transform:uppercase;color:#566d80;}
+.aaa-home__search-field>div{display:flex;align-items:center;gap:9px;min-width:0;}
+.aaa-home__search-field svg{color:#087ec3;flex:none;}
+.aaa-home__search-field input{padding:0!important;border:0!important;outline:0!important;box-shadow:none!important;min-height:25px!important;min-width:0;width:100%;font-size:13px;font-weight:600;background:transparent!important;color:#0b192b!important;}
+.aaa-home__search-field input:focus{outline:0!important;box-shadow:none!important;}
